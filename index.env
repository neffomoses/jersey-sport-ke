      </div>
      <div class="cart-items" id="cart-items"></div>
      <div class="cart-summary">
        <div>
          <span>Subtotal</span>
          <strong id="cart-total">KSH 0</strong>
        </div>
        <button id="proceed to checkout-button" class="button secondary">Proceed to Checkout</button>
      </div>
      <form id="cart-form" class="checkout-form" action="submit_order.php" method="POST">
        <h3>Send Order Inquiry</h3>
        <p>Tell us your name, phone, and email. We’ll handle the rest. Payment is via MPESA send money to <strong>0741465524</strong>.</p>
        <input type="text" name="name" placeholder="Your Name" required />
        <input type="email" name="email" placeholder="Your Email" required />
        <input type="tel" name="phone" placeholder="Phone Number" required />
        <textarea name="message" placeholder="Message or special request"></textarea>
        <input type="hidden" name="items" id="order-items" />
        <input type="hidden" name="total" id="order-total" />
        <button type="submit" class="button primary">Send Order</button>
      </form>
      <div class="contact-card">
        <h3>Contact Us</h3>
        <p>Phone: <a href="tel:0741465524">0741465524</a></p>
